# Copy to .env.local and fill in.
#
# Nothing here is NEXT_PUBLIC_*, and that is deliberate: anything with that
# prefix is compiled into the browser bundle and readable from devtools.
#
# There is no API key to configure. The console's only credential is the
# signed-in user's session, held in httpOnly cookies the browser cannot read.

# Where the qr-infra backend is reachable from the Next.js server.
API_BASE_URL=http://127.0.0.1:8787

# This console's own public origin. Used to reject cross-site writes at the
# proxy — SameSite=Lax is a browser behaviour, not a guarantee.
CONSOLE_URL=http://localhost:3000

# Shown on the signup and onboarding screens, so someone can see the address
# their printed codes will resolve at before committing to it. Must match
# RESOLVER_DOMAIN on the backend.
RESOLVER_DOMAIN=qr.example
