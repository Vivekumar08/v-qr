# Copy to .env.local and fill in.
#
# Neither variable is NEXT_PUBLIC_*, and that is deliberate: anything with that
# prefix is compiled into the browser bundle. An API key there is a key any
# visitor can read from devtools and use to revoke codes — and a revoked code is
# a printed label that stops working.

# Where the qr-infra backend is reachable from the Next.js server.
API_BASE_URL=http://127.0.0.1:8787

# An API key with the scopes the console needs: codes:read, codes:write,
# scans:read. Issue one per environment, never reuse a production key locally.
QR_INFRA_API_KEY=
